<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n2r_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/n2r_bg_sleep"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/n2r_content"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingTop="48dp"
        android:paddingEnd="26dp"
        android:paddingBottom="30dp">

        <!-- Phase pill -->
        <TextView
            android:id="@+id/n2r_phase_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/n2r_pill_bg"
            android:paddingStart="16dp"
            android:paddingTop="7dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:text="SLEEP GUARD"
            android:textColor="#E6FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.22" />

        <!-- Icon badge -->
        <FrameLayout
            android:id="@+id/n2r_icon_badge"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/n2r_icon_badge_bg">
            <TextView
                android:id="@+id/n2r_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🌙"
                android:textSize="44sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/n2r_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="Rest now"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/n2r_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="#B8FFFFFF"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Countdown card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/n2r_card_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNLOCKS IN"
                android:textColor="#8AFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.22" />

            <TextView
                android:id="@+id/n2r_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="--:--"
                android:textColor="#FFFFFFFF"
                android:textSize="42sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="STILL AVAILABLE"
            android:textColor="#8AFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.22" />

        <!-- Chip rows are built in code (NightToRiseBlockActivity.populateAllowedChips) -->
        <LinearLayout
            android:id="@+id/n2r_allowed_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/n2r_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/n2r_home_btn_bg"
            android:minHeight="56dp"
            android:stateListAnimator="@null"
            android:text="Return to Home"
            android:textAllCaps="false"
            android:textColor="#141A2B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/n2r_override"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Emergency unlock"
            style="?android:attr/borderlessButtonStyle"
            android:textAllCaps="false"
            android:textColor="#A6FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Phone and emergency calls are always reachable."
            android:textColor="#73FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
